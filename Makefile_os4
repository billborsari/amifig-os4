			mcc_zoomdisp.o    mcc_imagedisp.o \
            mcc_figdisp.o     mcc_arrowslider.o \
			mcc_colorswatch.o

TARGET  = AmiFIG_App/AmiFIG

$(TARGET): $(OBJS)
	mkdir -p $(dir $@)
	$(CC) -o $@ $^ $(LDFLAGS) 

%.o: %.c
	$(CC) $(CFLAGS) $(DEFINES) -o $@ -c $<

%.o: %.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -o $@ -c $<

main.o z_fig.o z_about.o: version.h

clean:
	rm -f *.o AmiFIG_App/AmiFIG
