            e_move.o          e_delete.o      \
            e_deletept.o      e_flip.o        \
            e_glue.o          e_movept.o      \
            e_rotate.o        e_scale.o       \
            e_update.o        e_break.o       \
            e_placelib.o      e_measure.o     \
            e_chop.o          e_joinsplit.o   \
            e_tangent.o       e_editsfactor.o \
			e_changedepth.o   \
            f_load.o          f_save.o        \
            f_picobj.o        f_read.o        \
            u_draw_spline.o   u_bound.o       \
            u_create.o        u_drag.o        \
            u_draw.o          u_elastic.o     \
            u_fonts.o         u_free.o        \
            u_geom.o          u_list.o        \
