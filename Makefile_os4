            w_canvas.o        w_intersect.o   \
            a_antialias.o     a_rexxiface.o   \
            a_eventloop.o     a_patterns.o    \
            a_color.o         a_area.o        \
            a_io.o            a_savebitmap.o  \
			a_print.o         a_icon.o        \
            a_coords.o        \
            resources.o       object.o        \
            intui.o           mode.o          \
            GradientFill.o    locale.o        \
            main.o            \
